{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parity-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parity-db-staging",
      "database_id": "759aef85-c583-4ae0-8fe2-a8afb95e3822",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "parity-photos-staging"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
